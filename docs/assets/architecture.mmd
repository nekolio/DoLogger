%% DoLogger architecture — host submission → lock-free ring → 7-stage pipeline
%% → 11 built-in sinks, with the audit chain, plugin trust model, and
%% compliance/security controls on the side.
%% Color key: blue = ingest · gray = pipeline · amber = audit-signing stage
%% (Assembly) · green = sinks · purple = security · extensibility · compliance.
flowchart LR
    %% ================= INGEST =================
    subgraph INGEST[INGEST — Lock-Free Submission]
        direction TB
        HOST[Host Application]
        ADAPTERS[Adapters — Rust SDK · C ABI · Python · Go]
        LOG[dologger_log() — CAS push · 102 ns P50]
        POOL[Treiber Object Pool — zero-alloc]
        RING[Lock-Free MPSC Ring — 90% normal / 10% audit · never drops]
        BP[Backpressure — 90% coop-help · 95% spill]
    end
    %% ================= PIPELINE =================
    subgraph PIPE[7-STAGE PIPELINE]
        direction TB
        S0[0 · PreFilter — rate limit · level gate]
        S1[1 · Filter — drop / pass rules]
        S2[2 · FieldProvider — inject fields · Ring 1]
        S3([3 · Assembly — LSN · prev_hash · Ed25519])
        S4[4 · Processing — CRC32C · secret scan]
        S5[5 · Formatting — JSON / text / SIF]
        S6[6 · Sink fan-out — core built-in · sinks.* config]
    end
    %% ================= SINK LAYER =================
    subgraph SINK[SINK LAYER — 11 Built-in Sinks]
        C[Console — stdout]
        F[File — rotation]
        K[Kafka — TLS + SASL]
        SYS[Syslog — UDP / TCP / TLS]
        WEB[Webhook — HTTPS]
        SQL[SQLite — local]
        OT[OTel — OTLP / HTTP]
        SHM[SHM — shared memory]
        CB[Callback — host extension]
        WORM[WORM — immutable audit]
        SEC[Security — 0600 · plugin-bypass]
    end
    %% ================= SECURITY & EXTENSIBILITY =================
    subgraph SECURITY[SECURITY · EXTENSIBILITY · COMPLIANCE]
        direction TB
        P1[Plugins — 9 VTable types · C ABI]
        SB[Sandbox — seccomp-bpf · AppContainer]
        P2[Trust anchors — active.pub · Blue / Yellow / Red]
        R1[Field permissions — Ring 0–3]
        A1[Audit chain — Ed25519 · LSN · prev_hash]
        A2[dologctl verify-log — offline verification]
        ND[Non-downgradable config — 6 items]
        CT[Compliance templates — GDPR · HIPAA · PCI-DSS]
        PP[Performance profiles — dev · prod-performance · prod-audit · balanced]
    end

    %% Ingest flow
    HOST --> ADAPTERS
    ADAPTERS --> LOG
    LOG -->|push| RING
    POOL -.->|alloc| LOG
    RING -.->|over 90%| BP

    %% Pipeline flow
    RING -->|drain| S0
    S0 --> S1 --> S2 --> S3 --> S4 --> S5 --> S6

    %% Sink fan-out (parallel dispatch over io_pool)
    S6 -->|io_pool| C
    S6 --> F
    S6 --> K
    S6 --> SYS
    S6 --> WEB
    S6 --> SQL
    S6 --> OT
    S6 --> SHM
    S6 --> CB
    S6 --> WORM
    S6 --> SEC

    %% Security column (list) + audit chain annotations
    P1 --- SB --- P2 --- R1 --- A1 --- A2 --- ND --- CT --- PP
    S3 -.->|sign| A1
    WORM -.->|verify| A2

    %% Zone tints + tasteful Assembly emphasis (amber, not loud orange)
    classDef ingest fill:#ddf4ff,stroke:#0969da
    classDef sink fill:#dafbe1,stroke:#1a7f37
    classDef audit fill:#fff8c5,stroke:#9a6700,stroke-width:1.5
    classDef sec fill:#fbefff,stroke:#8250df
    class HOST,ADAPTERS,LOG,POOL,RING,BP ingest
    class S3 audit
    class C,F,K,SYS,WEB,SQL,OT,SHM,CB,WORM,SEC sink
    class A1,A2,P1,P2,R1,SB,ND,CT,PP sec
